{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifnh.dev/config.schema.json",
  "title": "ifnh configuration",
  "description": "Layered JSON configuration for ifnh (DESIGN 3.5). Precedence, low to high: builtin defaults < user < project < session < env < cli. `src/core/config/schema.zig` embeds this file verbatim; the drift test keeps it in step with the builtin defaults.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Config format version. Unsupported values fail startup."
    },
    "model": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "openai-responses", "gemini"]
        },
        "model": {
          "type": "string",
          "description": "Model id sent to the provider; empty means unconfigured."
        },
        "base_url": {
          "type": ["string", "null"],
          "description": "Provider endpoint override; null uses the provider default."
        },
        "api_key_env": {
          "type": "string",
          "description": "Environment variable that holds the API key."
        },
        "auth": {
          "type": "string",
          "enum": ["api_key", "oauth"],
          "default": "api_key",
          "description": "How the key in api_key_env is sent. Only gemini reads it: \"oauth\" sends it as Authorization: Bearer (a Google OAuth access token) instead of x-goog-api-key. A models.aliases.<name> entry may set it too. There is no login flow; supply the token through the env var or /provider key."
        },
        "temperature": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 2
        },
        "max_output_tokens": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "provider_options": {
          "type": "object",
          "additionalProperties": true,
          "description": "Provider-specific request options, passed through verbatim."
        },
        "provider_label": {
          "type": "string",
          "description": "Display label for a custom OpenAI-compatible endpoint."
        },
        "tools_enabled": {
          "type": "boolean",
          "description": "Whether the model is told about tools (false for chat-only models)."
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Alias -> model id."
        },
        "fallbacks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": "Model id -> ordered fallback chain."
        },
        "provider_options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "parent": { "type": "string" },
        "research": { "type": "string" },
        "implement": { "type": "string" },
        "review": { "type": "string" }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "prompt": { "type": "string" }
        }
      },
      "description": "Named config overlays applied with --profile; `prompt` is appended to the system prompt."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "default_mode": {
          "type": "string",
          "enum": ["ask", "auto"]
        },
        "read": {
          "type": "array",
          "items": { "type": "string" }
        },
        "write": {
          "type": "array",
          "items": { "type": "string" }
        },
        "command_allow": {
          "type": "array",
          "items": { "type": "string" }
        },
        "command_deny": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env_allow": {
          "type": "array",
          "items": { "type": "string" }
        },
        "read_dotenv": { "type": "boolean" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "commits": { "type": "string", "enum": ["never", "ask", "auto"] },
        "push": { "type": "string", "enum": ["never", "ask", "auto"] },
        "force_push": { "type": "string", "enum": ["never", "ask", "auto"] }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0 },
        "max_concurrent": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "max_tool_rounds": { "type": "integer", "minimum": 1 },
        "timeout_tool_s": { "type": "integer", "minimum": 1 },
        "budget_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "external": {
          "type": "boolean",
          "description": "Allow external tools launched from .ifnh/tools/."
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "auto_compact": { "type": "boolean" },
        "compact_at_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_file_read_bytes": { "type": "integer", "minimum": 1 },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Context window size used by the footer and /context."
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dir": {
          "type": "string",
          "description": "\"project\" keeps sessions in .ifnh/sessions; any other value is a path."
        },
        "keep": { "type": "integer", "minimum": 1 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "colors": { "type": "boolean" },
        "footer": { "type": "boolean" }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "redact": { "type": "boolean" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional advisory memory (DECISIONS Q223-232). Off by default; entries are only read or written by the model's explicit memory_* tool calls, never injected into the prompt.",
      "properties": {
        "adapter": {
          "type": "string",
          "enum": ["none", "file", "mcp"],
          "description": "none: off. file: JSONL files under .ifnh/memory/ (project) or the user config dir (user). mcp: proxy to the mcp_servers entry named by server."
        },
        "scope": {
          "type": "string",
          "enum": ["project", "user"],
          "description": "Where entries live."
        },
        "server": {
          "type": "string",
          "description": "mcp adapter only: name of an mcp_servers entry. Required when adapter is mcp."
        },
        "tools": {
          "type": "object",
          "description": "mcp adapter only: tool names on the server, keys recall, remember and forget. Defaults: memory_recall, memory_remember, memory_forget.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "hooks": {
      "type": "object",
      "description": "Lifecycle hooks (D-07): event name (session_start, session_end, before_agent, after_agent, before_stage, after_stage, before_tool, after_tool, before_merge, after_merge) mapped to a command, a list of commands, or a list of objects.",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "command": { "type": "string" },
                    "matcher": { "type": "string", "description": "Pipe-separated exact tool names; empty or * matches every tool." },
                    "timeout_s": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 }
                  },
                  "required": ["command"],
                  "additionalProperties": false
                }
              ]
            }
          }
        ]
      }
    },
    "mcp_servers": {
      "type": "object",
      "description": "MCP server definitions, keyed by server name. Each sets exactly one of command (stdio) or url (Streamable HTTP).",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "Stdio server: program to spawn. Exclusive with url."
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Stdio server: arguments."
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Stdio server: extra environment variables."
          },
          "required": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Streamable HTTP server endpoint. Exclusive with command."
          },
          "headers": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "HTTP server: extra request headers (for example Authorization)."
          },
          "agents": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Agent identities allowed to use the server: parent, research, implement, review. Absent or empty means every agent."
          }
        },
        "oneOf": [
          { "required": ["command"] },
          { "required": ["url"] }
        ]
      }
    }
  }
}
